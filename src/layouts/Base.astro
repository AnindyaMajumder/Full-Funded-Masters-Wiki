---
import '../styles/global.css';
import { COUNTRY_ORDER, COUNTRY_LABELS } from '../lib/scholarship';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Full-Funded Masters Wiki',
  description = 'A verifiable directory of fully funded master’s scholarships across the UK, Europe, Australia, the USA, China and Japan — every fact cited to its official source.',
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const navItems = [
  { href: '/', label: 'Home' },
  ...COUNTRY_ORDER.map((k) => ({ href: `/${k}`, label: COUNTRY_LABELS[k] })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Full-Funded Masters Wiki — home">
          <span class="brand__mark" aria-hidden="true">FF</span>
          <span>Full-Funded&nbsp;Masters</span>
        </a>
        <nav class="nav" aria-label="Countries">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container cols">
        <div>
          <strong>Full-Funded Masters Wiki</strong>
          <p class="faint" style="max-width: 46ch; margin-top: 0.4rem;">
            Every scholarship is checked against its official source. Always confirm
            details on the official page before applying — cycles and rules change.
          </p>
        </div>
        <div>
          <p class="faint">Data anchor: June 2026</p>
          <p class="faint">Built with Astro · static &amp; cited</p>
        </div>
      </div>
    </footer>
  </body>
</html>
