---
import ScholarshipCard from './ScholarshipCard.tsx';
import ScholarshipFilter from './ScholarshipFilter.tsx';
import { sortFeatured } from '../lib/scholarship';
import type { ScholarshipWithCountry } from '../types/scholarship';

interface Props {
  items: ScholarshipWithCountry[];
  gridId?: string;
  showCountry?: boolean;
}

const { items, gridId = 'scholarships', showCountry = true } = Astro.props;
const sorted = sortFeatured(items);
---

<section class="stack">
  <div class="filter">
    <ScholarshipFilter client:load gridId={gridId} showCountry={showCountry} />
  </div>

  {sorted.length > 0 ? (
    <>
      <noscript>
        <p class="noscript-note">
          Filtering needs JavaScript. All {sorted.length} scholarships are listed below.
        </p>
      </noscript>
      <div class="grid" id={gridId}>
        {sorted.map((item, i) => <ScholarshipCard item={item} index={i} />)}
      </div>
      <div class="empty-state" id={`${gridId}-empty`} hidden>
        No scholarships match these filters. <strong>Clear filters</strong> to see them all.
      </div>
    </>
  ) : (
    <div class="empty-state">
      No scholarships here yet — this section is being researched and verified.
    </div>
  )}
</section>
