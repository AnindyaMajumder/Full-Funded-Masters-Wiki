{
  // Cloudflare Workers config for the SvelteKit static site.
  // Its presence tells Cloudflare Workers Builds the project is already configured,
  // so it runs `npm run build` (vite build) instead of injecting `wrangler types --check`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "full-funded-masters-wiki",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
